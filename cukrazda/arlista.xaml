<Window x:Class="cukrazda.arlista"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cukrazda"
        mc:Ignorable="d"
        Title="arlista" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="ItemsGrid" Grid.Row="0" Grid.Column="0"
              AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sütemény" Binding="{Binding Name}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ár" Binding="{Binding Price, StringFormat={}{0} Ft}" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="Rendel?" Binding="{Binding Order, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Darab" Binding="{Binding Amount}"/>
            </DataGrid.Columns>
        </DataGrid>

        <RichTextBox x:Name="SzamlaBox" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0"
                 IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>

        <Button Grid.Row="1" Grid.ColumnSpan="2" Content="Rendel" Click="Rendel_Click"
            HorizontalAlignment="Right" Width="100" Margin="0,10,0,0">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Számlát kér" Click="SzamlatKer_Click"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </Grid>

</Window>
